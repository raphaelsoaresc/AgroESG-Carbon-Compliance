cat > .gcloudignore <<EOF
# --- Ambiente Nix e Python (O PESO ESTÁ AQUI) ---
.devenv/
.direnv/
.venv/
venv/
uv.lock
devenv.lock
devenv.nix
devenv.yaml
.devenv.flake.nix
__pycache__/
*.pyc

# --- Git e Configurações ---
.git/
.github/
.gitignore
.vscode/
.user.yml
.env
.envrc

# --- Dados Pesados (Parquet, CSV, JSON) ---
*.parquet
*.geoparquet
*.csv
*.json
data/
logs/

# --- Pastas do Projeto não usadas na API ---
# (Baseado na sua lista, a API só usa main.py e schemas.py)
agro_credit_transform/
airflow/
assets/
config/
legacy/
notebooks/
scripts/
src/
utils/
tests/

# --- Arquivos do Streamlit (Painel) ---
.streamlit/
app.py
Dockerfile.streamlit
requirements.txt

# --- Outros ---
README.md
LICENSE
pyproject.toml
EOF