cat > .gcloudignore <<EOF
# --- Arquivos de Sistema e Sockets (CORREÇÃO DO ERRO) ---
gunicorn.ctl
*.ctl
*.sock
.DS_Store

# --- Ambiente Nix e Python ---
.devenv/
.direnv/
.venv/
venv/
uv.lock
devenv.lock
devenv.nix
devenv.yaml
.devenv.flake.nix
__pycache__/
*.pyc

# --- Git e Configurações ---
.git/
.github/
.gitignore
.vscode/
.user.yml
.env
.envrc

# --- Dados Pesados (Parquet, CSV, JSON) ---
*.parquet
*.geoparquet
*.csv
*.json
data/
logs/
/tmp/

# --- Pastas do Projeto não usadas na API ---
agro_credit_transform/
airflow/
assets/
config/
legacy/
notebooks/
scripts/
src/
utils/
tests/

# --- Arquivos do Streamlit (Painel) ---
.streamlit/
app.py
Dockerfile.streamlit
# requirements.txt  <-- Removi do ignore caso sua API precise dele!

# --- Outros ---
README.md
LICENSE
pyproject.toml
EOF